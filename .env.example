# Mamazu BnB Environment Variables

# API Keys (if needed in future)
# VITE_API_KEY=your_api_key_here
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Contact Form Configuration (if using email service)
# VITE_EMAIL_SERVICE_ID=your_email_service_id
# VITE_EMAIL_TEMPLATE_ID=your_email_template_id
# VITE_EMAIL_PUBLIC_KEY=your_email_public_key

# Application Configuration
# VITE_APP_URL=http://localhost:5173
# VITE_APP_NAME=Mamazu BnB

# Analytics (if needed)
# VITE_GOOGLE_ANALYTICS_ID=your_ga_id

# Feature Flags
# VITE_ENABLE_BOOKING=false
# VITE_ENABLE_REVIEWS=false
