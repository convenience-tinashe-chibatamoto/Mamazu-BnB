{
  "name": "mamazu-bnb",
  "private": true,
  "version": "1.0.0",
  "description": "Executive Luxury Fully Furnished Home for Short-term rental in Greendale, Harare - Modern React website for Mamazu BnB",
  "type": "module",
  "author": "Mamazu BnB",
  "homepage": "https://lightgrey-mantis-680447.hostingersite.com/",
  "keywords": ["bnb", "accommodation", "harare", "zimbabwe", "luxury", "react", "vite", "tailwindcss"],
  "repository": {
    "type": "git",
